<!DOCTYPE html>
<html lang="es">
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
        <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.9.2/dist/umd/popper.min.js" integrity="sha384-IQsoLXl5PILFhosVNubq5LC7Qb9DXgDA9i+tQ8Zj3iwWAwPtgFTxbJ8NT4GN1R8p" crossorigin="anonymous"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.min.js" integrity="sha384-cVKIPhGWiC2Al4u+LWgxfKTRIcfu0JTxR+EQDz/bgldoEyl4H0zUF0QKbrJ0EcQF" crossorigin="anonymous"></script>
        {% block stylesheets %}
        {% endblock %}
        <style>
            body {
                background-color: #ECEFF1;
                height: 100vh;
                font-family: "Segoe UI" !important;

                nav {
                    background-color: #173341;
                    color: white !important;
                    font-weight: bold;
                }
            }

            h1 {
                color: black;
                font-weight: bold;
            }

            h2 {
                color: black;
                font-weight: bold;
            }

            #main {
                display: flex;
                justify-content: start;
                align-items: center;
                flex-direction: column;
            }

            #carouselExample {
                width: 50%;
            }

            table {
                margin-top: 30px;
                border: 4px solid black;

                th {
                    text-align: center !important;
                    color: white;
                    background-color: #173341 !important;
                }

                tr, td {
                    background-color: white !important;
                    text-align: center;
                    font-weight: bold;
                }

                td {
                    max-width: 300px;
                    white-space: normal;
                    word-wrap: break-word;
                }
            }

            .form-container {
                display: flex;
                justify-content: flex-start;
                align-items: center;
                flex-direction: column;

                form {
                    display: flex;
                    flex-direction: column;
                    align-items: center;

                    button {
                        width: 157.6px;
                        color: white;
                        font-weight: bold;
                        margin-bottom: 10px;
                    }
                }
            }

            .button-container {
                display: flex;
                gap: 22px;

                button {
                    background-color: #173341 !important;
                }

                a {
                    text-decoration: none;
                    color:white;
                    font-weight: bold;
                }
            }

            .not-found-data {

                display: flex;
                flex-direction: column;
                justify-content: center;
                align-items: center;
                margin-top: 15px;

                img {
                    height: 328px !important;
                    border-radius: 40px;
                }

                p {
                    font-size: 27px;
                    color: black;
                    font-weight: bold;
                }
            }

            .input {
                margin-top: 20px;
                margin-bottom: 10px !important;

                input {
                    width: 300px !important;
                }
            }

            .buttons {
                background-color: #173341 !important;
                color: white;
                font-weight: bold;
            }

            a {
                text-decoration: none;
                color: black;
                font-weight: bold;

                svg {
                    color: #173341 !important;
                    width: 29px;
                }
            }

            .eye {
                svg {
                    margin-top: 3px;
                }
            }

            .forms {
                display: flex;
                justify-content: center;
                align-items: center;
                flex-direction: column;

                button {
                    width: 157.6px;
                    color: white;
                    font-weight: bold;
                    margin-bottom: 10px;
                }
            }

            .delete-button {
                width: 157.6px;
                color: white;
                font-weight: bold;
                margin-bottom: 10px;
                display: flex;
                justify-content: center;
                align-items: center;
                gap: 7px;

                svg {
                    width: 29px;
                }
            }

            .save-button {
                display: flex;
                justify-content: center;
                align-items: center;
                margin-top: 20px;


                button {
                    width: 157.6px;
                    color: white;
                    font-weight: bold;
                    margin-bottom: 10px;
                    background-color: #173341 !important;
                }
            }

            .employee-image {
                max-width: 100px;
                height: auto;
            }

            .achievement-form {
                width: 458px !important;
            }

            .custom-checkbox-wrapper {
                display: flex;
                align-items: center;
                margin-bottom: 10px;
            }

            .custom-checkbox-wrapper label {
                margin-right: 10px; /* Espacio entre el texto y el checkbox */
            }

            input[type="checkbox"] {
                width: 18px;
                height: 18px;
                cursor: pointer; /* Cambia el cursor cuando pasas sobre el checkbox */
            }


            .delete-icon {
                background-color: transparent;
                border: transparent;
                svg {
                    width: 29px;
                    color: red;
                }
            }

            .group {
                font-size: 17px;
                font-weight: bold;
                text-align: center;
            }
        </style>

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>

    {% set excludedRoutes = ['app_employee_pdf_index', 'app_store_pdf_index', 'app_employee_achievement_all_pdf', 'app_employee_achievements_pdf', 'app_employee_detail_pdf', 'app_employee_warnings_pdf'] %}
    {% if app.request.attributes.get('_route') not in excludedRoutes %}
        <nav class="navbar navbar-expand-lg navbar-dark ">
            <div class="container-fluid">
                <a class="navbar-brand" href="{{ path('app_index') }}">Intelafix</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup" aria-controls="navbarNavAltMarkup" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
                    <div class="navbar-nav">
                        <a class="nav-link {{ app.request.attributes.get('_route') == 'app_store_index' ? 'active' : '' }}" href="{{ path('app_store_index') }}">Tiendas</a>
                        <a class="nav-link {{ app.request.attributes.get('_route') == 'app_positions_index' ? 'active' : '' }}" href="{{ path('app_positions_index') }}">Puestos</a>
                        <a class="nav-link {{ app.request.attributes.get('_route') == 'app_employee_index' ? 'active' : '' }}" href="{{ path('app_employee_index') }}">Empleados</a>
                    </div>
                </div>
            </div>
        </nav>
    {% endif %}

        <div class="p-3" id="main">
            {% block body %}{% endblock %}
            {% if app.request.attributes.get('_route') == 'app_index' %}
                <h1>Proyecto Final - Desarrollo Web </h1>
                <p class="group">
                    Integrantes del grupo <br>
                    José Enrique Salazar Bobadilla | 5190-21-893 <br>
                    Javier Alejandro Barahona Pasán | 5190-21-3152 <br>
                    Raúl Alfonso Galdámez Orellana | 5190-21-3565
                </p>
                <h1 class="title">Intelafix</h1>
                <h2 class="subtitle">La tecnología al alcance de tu mano.</h2>

                <div id="carouselExample" class="carousel slide carousel-fade" data-bs-ride="carousel">
                    <div class="carousel-inner">
                        <div class="carousel-item active" data-bs-interval="3000">
                            <img src={{asset("images/slide-1.jpg")}} class="d-block w-100" alt="Slide 1">
                        </div>
                        <div class="carousel-item" data-bs-interval="3000">
                            <img src={{asset("images/slide-2.jpg")}} class="d-block w-100" alt="Slide 2">
                        </div>
                    </div>
                    <button class="carousel-control-prev" type="button" data-bs-target="#carouselExample" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Previous</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#carouselExample" data-bs-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Next</span>
                    </button>
                </div>
            {% endif %}
        </div>
    </body>
</html>
